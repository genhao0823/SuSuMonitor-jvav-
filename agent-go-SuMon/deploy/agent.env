# SuSuMonitor Agent 环境变量配置文件。
#
# 部署路径：/etc/susumonitor/agent.env
# 修改后执行：sudo systemctl restart susumonitor-agent
# 敏感字段（SUSUMONITOR_AGENT_TOKEN）不要提交到 Git。

SUSUMONITOR_BACKEND_URL=ws://your-backend-host:18080
SUSUMONITOR_SERVER_ID=1
SUSUMONITOR_AGENT_TOKEN=REPLACE_WITH_YOUR_TOKEN
SUSUMONITOR_COLLECT_INTERVAL_SECONDS=5
SUSUMONITOR_HEARTBEAT_INTERVAL_SECONDS=30
SUSUMONITOR_RECONNECT_INITIAL_SECONDS=5
SUSUMONITOR_RECONNECT_MAX_SECONDS=60
SUSUMONITOR_LOG_LEVEL=info
