[Unit]
Description=SuSuMonitor Java Backend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=susumonitor
Group=susumonitor
WorkingDirectory=/opt/susumonitor/server
EnvironmentFile=/etc/susumonitor/server.env
Environment="JAVA_TOOL_OPTIONS=-Xms256m -Xmx768m -Dfile.encoding=UTF-8"
ExecStart=/usr/bin/java -jar /opt/susumonitor/server/susumonitor-server.jar
Restart=on-failure
RestartSec=5
SuccessExitStatus=143
UMask=0077
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=full
ReadWritePaths=/var/lib/susumonitor
StateDirectory=susumonitor
LimitNOFILE=65536

[Install]
WantedBy=multi-user.target
