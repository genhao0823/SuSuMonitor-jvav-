{
  "openapi": "3.0.3",
  "info": {
    "title": "SuSuMonitor Authentication API",
    "description": "SuSuMonitor authentication API for Apifox import and local testing.",
    "version": "0.1.0"
  },
  "servers": [
    {
      "url": "http://localhost:18080",
      "description": "Local development server"
    }
  ],
  "tags": [
    {
      "name": "auth",
      "description": "Authentication and registration"
    }
  ],
  "paths": {
    "/api/auth/register": {
      "post": {
        "tags": ["auth"],
        "summary": "Register user",
        "description": "Registers a user. The first user becomes admin/approved; subsequent users become user/pending.",
        "operationId": "registerUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/RegisterRequest"
              },
              "example": {
                "username": "admin",
                "password": "REPLACE_WITH_PASSWORD"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "User registered",
            "headers": {
              "X-Request-ID": {
                "$ref": "#/components/headers/XRequestId"
              }
            },
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CurrentUserResponse"
                }
              }
            }
          },
          "400": {
            "description": "Invalid request parameter",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40002,
                  "message": "invalid request parameter",
                  "data": null
                }
              }
            }
          },
          "409": {
            "description": "Username already exists",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorResponse"
                },
                "example": {
                  "code": 40900,
                  "message": "resource conflict",
                  "data": null
                }
              }
            }
          }
        }
      }
    },
    "/api/auth/login": {
      "post": {
        "tags": ["auth"],
        "summary": "Login",
        "description": "Authenticates credentials and returns a JWT for approved users. Cache-Control: no-store is set on the response.",
        "operationId": "loginUser",
        "parameters": [
          {
            "$ref": "#/components/parameters/XRequestId"
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {"$ref": "#/components/schemas/LoginRequest"},
              "example": {
                "username": "admin",
                "password": "REPLACE_WITH_PASSWORD"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Login successful",
            "headers": {
              "X-Request-ID": {"$ref": "#/components/headers/XRequestId"},
              "Cache-Control": {
                "description": "Always 'no-store' to prevent caching of the JWT.",
                "schema": {"type": "string", "example": "no-store"}
              }
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/LoginResponse"},
                "example": {
                  "code": 0,
                  "message": "success",
                  "data": {
                    "token": "REPLACE_WITH_JWT",
                    "tokenType": "Bearer",
                    "expiresIn": 259200,
                    "user": {
                      "id": 1,
                      "username": "admin",
                      "role": "admin",
                      "reviewStatus": "approved",
                      "reviewedAt": "2026-07-20T00:00:00Z",
                      "createdAt": "2026-07-20T00:00:00Z"
                    }
                  }
                }
              }
            }
          },
          "400": {"$ref": "#/components/responses/InvalidRequestParameter"},
          "401": {
            "description": "Invalid username or password (40001)",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"code": 40001, "message": "invalid username or password", "data": null}
              }
            }
          },
          "403": {
            "description": "User is not yet approved (40300)",
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/ErrorResponse"},
                "example": {"code": 40300, "message": "forbidden", "data": null}
              }
            }
          }
        }
      }
    },
    "/api/auth/me": {
      "get": {
        "tags": ["auth"],
        "summary": "Current user",
        "description": "Returns the latest database snapshot of the authenticated user. The server re-queries the database on every call.",
        "operationId": "getCurrentUser",
        "parameters": [
          {"$ref": "#/components/parameters/XRequestId"}
        ],
        "responses": {
          "200": {
            "description": "Current user snapshot",
            "headers": {
              "X-Request-ID": {"$ref": "#/components/headers/XRequestId"}
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/CurrentUserResponse"}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    },
    "/api/auth/logout": {
      "post": {
        "tags": ["auth"],
        "summary": "Logout",
        "description": "Stateless logout acknowledgement. The client is responsible for deleting the local JWT.",
        "operationId": "logoutUser",
        "parameters": [
          {"$ref": "#/components/parameters/XRequestId"}
        ],
        "responses": {
          "200": {
            "description": "Logout acknowledged",
            "headers": {
              "X-Request-ID": {"$ref": "#/components/headers/XRequestId"}
            },
            "content": {
              "application/json": {
                "schema": {"$ref": "#/components/schemas/EmptyResponse"},
                "example": {"code": 0, "message": "success", "data": null}
              }
            }
          },
          "401": {"$ref": "#/components/responses/Unauthorized"}
        }
      }
    }
  },
  "components": {
    "parameters": {
      "XRequestId": {
        "name": "X-Request-ID",
        "in": "header",
        "required": false,
        "description": "Optional request trace ID. The server generates one when omitted.",
        "schema": {
          "type": "string"
        }
      }
    },
    "headers": {
      "XRequestId": {
        "description": "Request trace ID returned by the server.",
        "schema": {
          "type": "string"
        }
      }
    },
    "responses": {
      "Unauthorized": {
        "description": "Missing, invalid, or expired JWT (40100)",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"},
            "example": {"code": 40100, "message": "unauthorized", "data": null}
          }
        }
      },
      "InvalidRequestParameter": {
        "description": "Invalid request parameter (40002)",
        "content": {
          "application/json": {
            "schema": {"$ref": "#/components/schemas/ErrorResponse"},
            "example": {"code": 40002, "message": "invalid request parameter", "data": null}
          }
        }
      }
    },
    "schemas": {
      "RegisterRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 3,
            "maxLength": 50,
            "pattern": "^[A-Za-z0-9_]+$"
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 8,
            "maxLength": 64,
            "writeOnly": true
          }
        }
      },
      "LoginRequest": {
        "type": "object",
        "required": ["username", "password"],
        "properties": {
          "username": {
            "type": "string",
            "minLength": 1,
            "maxLength": 50
          },
          "password": {
            "type": "string",
            "format": "password",
            "minLength": 1,
            "maxLength": 64,
            "writeOnly": true
          }
        }
      },
      "LoginVo": {
        "type": "object",
        "required": ["token", "tokenType", "expiresIn", "user"],
        "properties": {
          "token": {"type": "string", "description": "JWT bearer token. Never logged or returned by other endpoints."},
          "tokenType": {"type": "string", "example": "Bearer"},
          "expiresIn": {"type": "integer", "format": "int64", "description": "Token lifetime in seconds."},
          "user": {"$ref": "#/components/schemas/CurrentUser"}
        }
      },
      "LoginResponse": {
        "type": "object",
        "required": ["code", "message", "data"],
        "properties": {
          "code": {"type": "integer", "example": 0},
          "message": {"type": "string", "example": "success"},
          "data": {"$ref": "#/components/schemas/LoginVo"}
        }
      },
      "EmptyResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {"type": "integer", "example": 0},
          "message": {"type": "string", "example": "success"},
          "data": {"nullable": true}
        }
      },
      "CurrentUserResponse": {
        "type": "object",
        "required": ["code", "message", "data"],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "example": 0
          },
          "message": {
            "type": "string",
            "example": "success"
          },
          "data": {
            "$ref": "#/components/schemas/CurrentUser"
          }
        }
      },
      "CurrentUser": {
        "type": "object",
        "required": ["id", "username", "role", "reviewStatus", "createdAt"],
        "properties": {
          "id": {
            "type": "integer",
            "format": "int64"
          },
          "username": {
            "type": "string"
          },
          "role": {
            "type": "string",
            "enum": ["admin", "user"]
          },
          "reviewStatus": {
            "type": "string",
            "enum": ["pending", "approved", "rejected"]
          },
          "reviewedAt": {
            "type": "string",
            "format": "date-time",
            "nullable": true
          },
          "createdAt": {
            "type": "string",
            "format": "date-time"
          }
        }
      },
      "ErrorResponse": {
        "type": "object",
        "required": ["code", "message"],
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "nullable": true
          }
        }
      }
    }
  }
}
